<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.ExpenseMate.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/background</item>
        <item name="titleTextAppearance">@style/Text.ExpenseMate.ScreenTitle</item>
    </style>

    <style name="Widget.ExpenseMate.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.ExpenseMate.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/Shape.ExpenseMate.Sheet</item>
    </style>

    <style name="Shape.ExpenseMate.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Tinted fields with no outline or underline; focus shows as a deeper tint -->
    <style name="Widget.ExpenseMate.Field" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/field_box</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <style name="Widget.ExpenseMate.Dropdown" parent="Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/field_box</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- A pill track holding the type choices, with the chosen one filled -->
    <style name="Widget.ExpenseMate.SegmentGroup" parent="Widget.Material3.MaterialButtonToggleGroup">
        <item name="android:background">@drawable/bg_segment</item>
        <item name="android:padding">4dp</item>
        <item name="singleSelection">true</item>
        <item name="selectionRequired">true</item>
    </style>

    <style name="Widget.ExpenseMate.Segment" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@color/segment_background</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="Widget.ExpenseMate.FormChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/form_chip_background</item>
        <item name="android:textColor">@color/form_chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.ExpenseMate.FormAction" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/field</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipIconTint">@color/primary</item>
    </style>

    <!-- Lets chips made in code pick up the form chip style -->
    <style name="ThemeOverlay.ExpenseMate.FormChips" parent="">
        <item name="chipStyle">@style/Widget.ExpenseMate.FormChip</item>
    </style>

    <style name="Widget.ExpenseMate.Save" parent="Widget.ExpenseMate.Primary">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.ExpenseMate.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.ExpenseMate.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Text.ExpenseMate.ScreenTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Text.ExpenseMate.SheetTitle" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Text.ExpenseMate.Hero" parent="">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.ExpenseMate.CardTitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Text.ExpenseMate.Row" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Text.ExpenseMate.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Text.ExpenseMate.Sub" parent="">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="Text.ExpenseMate.SubLine" parent="Text.ExpenseMate.Sub">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Text.ExpenseMate.Amount" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Text.ExpenseMate.Section" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- The small labels under an activity row: category, virtual and real account -->
    <style name="Text.ExpenseMate.Pill" parent="">
        <item name="android:textSize">11.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxWidth">140dp</item>
    </style>

    <style name="Text.ExpenseMate.Pill.Category">
        <item name="android:background">@drawable/bg_pill_category</item>
        <item name="android:textColor">@color/on_primary_container</item>
    </style>

    <style name="Text.ExpenseMate.Pill.Account">
        <item name="android:background">@drawable/bg_pill_account</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:drawableStart">@drawable/ic_wallet_small</item>
        <item name="android:drawableTint">@color/primary</item>
    </style>

    <style name="Text.ExpenseMate.Pill.Real">
        <item name="android:background">@drawable/bg_pill_real</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:drawableStart">@drawable/ic_bank_small</item>
        <item name="android:drawableTint">@color/on_surface_variant</item>
    </style>

    <style name="Text.ExpenseMate.Tag" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:background">@drawable/bg_tag</item>
    </style>
</resources>
