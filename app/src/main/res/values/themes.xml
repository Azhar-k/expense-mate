<resources>
    <style name="Theme.ExpenseMate" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSecondaryContainer">@color/primary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_container</item>
        <item name="colorTertiary">@color/transfer</item>
        <item name="colorError">@color/alert</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorOutline">@color/on_surface_variant</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.ExpenseMate.BottomSheet</item>
        <item name="toolbarStyle">@style/Widget.ExpenseMate.Toolbar</item>
        <item name="materialCardViewStyle">@style/Widget.ExpenseMate.Card</item>
        <item name="textInputStyle">@style/Widget.ExpenseMate.Field</item>
    </style>

    <style name="ThemeOverlay.ExpenseMate.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.ExpenseMate.BottomSheet</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>
</resources>
