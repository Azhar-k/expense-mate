<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Sample message"
        app:helperText="Paste a message from your bank. Select its amount and tap Amount, then select the merchant and tap Merchant.">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/btnPaste"
            style="@style/Widget.ExpenseMate.FormAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paste" />

        <com.google.android.material.chip.Chip
            android:id="@+id/btnMarkAmount"
            style="@style/Widget.ExpenseMate.FormAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amount" />

        <com.google.android.material.chip.Chip
            android:id="@+id/btnMarkMerchant"
            style="@style/Widget.ExpenseMate.FormAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Merchant" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/tvResult"
        style="@style/Text.ExpenseMate.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_segment"
        android:padding="12dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/typeToggle"
        style="@style/Widget.ExpenseMate.SegmentGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/typeDebit"
            style="@style/Widget.ExpenseMate.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Money out" />

        <Button
            android:id="@+id/typeCredit"
            style="@style/Widget.ExpenseMate.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Money in" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPattern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Pattern"
        app:helperText="A regular expression. Name the parts (?&lt;amount&gt;…) and (?&lt;merchant&gt;…).">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="top"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCounterparty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Counterparty (optional)"
        app:helperText="A fixed name to use instead of the merchant. {merchant} puts the merchant in it.">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCounterparty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchExclude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_segment"
        android:minHeight="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:text="Leave out of totals" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_segment"
        android:minHeight="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:text="On" />
</LinearLayout>
