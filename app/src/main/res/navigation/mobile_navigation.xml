<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.expensemate.ui.home.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/navigation_activity"
        android:name="com.example.expensemate.ui.activity.ActivityFragment"
        android:label="Activity" />

    <fragment
        android:id="@+id/navigation_bills"
        android:name="com.example.expensemate.ui.bills.BillsFragment"
        android:label="Bills" />

    <fragment
        android:id="@+id/navigation_accounts"
        android:name="com.example.expensemate.ui.accounts.AccountsFragment"
        android:label="Accounts" />

    <fragment
        android:id="@+id/account_details_fragment"
        android:name="com.example.expensemate.ui.accounts.AccountDetailsFragment"
        android:label="Account">
        <argument
            android:name="accountId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/navigation_loans"
        android:name="com.example.expensemate.ui.loans.LoansFragment"
        android:label="Money lent" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.expensemate.ui.settings.SettingsFragment"
        android:label="Settings" />

    <fragment
        android:id="@+id/navigation_sms_scan"
        android:name="com.example.expensemate.ui.sms.SmsScanFragment"
        android:label="Scan messages" />

    <fragment
        android:id="@+id/navigation_categories"
        android:name="com.example.expensemate.ui.categories.CategoriesFragment"
        android:label="Categories" />
</navigation>
